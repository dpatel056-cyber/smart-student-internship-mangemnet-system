<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="admin.master.cs" Inherits="asp.net.admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - SIMS | Smart Student Internship Management System</title>
    <meta name="description" content="SIMS Admin Dashboard - Full platform monitoring and management.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/style.css") %>">
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/company-module.css") %>">
    <style>
        .adm-stat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(185px,1fr)); gap:16px; margin-bottom:26px; }
        .adm-stat-card { background:#fff; border:1px solid var(--border-light, #e2e8f0); border-radius:12px; padding:18px 16px; display:flex; align-items:center; gap:14px; transition:box-shadow .2s,transform .2s; cursor:pointer; text-decoration:none; }
        .adm-stat-card:hover { box-shadow:0 8px 24px rgba(0,0,0,.07); transform:translateY(-2px); }
        .adm-stat-icon { width:46px;height:46px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0; }
        .adm-stat-num  { font-size:24px;font-weight:800;color:var(--text-dark, #0f172a);line-height:1; }
        .adm-stat-lbl  { font-size:12px;color:var(--text-muted, #64748b);margin-top:3px; }
        .adm-stat-chg  { font-size:11px;margin-top:3px; }
        .chg-up   { color:#16a34a; } .chg-down { color:#ef4444; } .chg-warn { color:#f59e0b; }

        .adm-qa-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px;margin-bottom:26px; }
        .adm-qa-card { background:#fff;border:1px solid var(--border-light, #e2e8f0);border-radius:12px;padding:18px 12px;text-align:center;text-decoration:none;color:inherit;transition:all .2s; }
        .adm-qa-card:hover { border-color:var(--primary, #2563eb);box-shadow:0 4px 16px rgba(37,99,235,.1);transform:translateY(-2px); }
        .adm-qa-icon { width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:19px;margin:0 auto 10px; }
        .adm-qa-card h4 { font-size:12.5px;font-weight:600;color:var(--text-dark, #0f172a);margin:0; }

        .adm-bar-chart  { display:flex;align-items:flex-end;gap:8px;height:160px;padding-top:12px; }
        .adm-bar-col    { flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;height:100%;justify-content:flex-end; }
        .adm-bar        { width:100%;border-radius:5px 5px 0 0;min-height:4px;transition:height .5s; }
        .adm-bar-lbl    { font-size:10.5px;color:var(--text-muted, #64748b); }
        .adm-bar-val    { font-size:10.5px;font-weight:700;color:var(--text-dark, #0f172a); }

        .donut-ring  { position:relative;width:140px;height:140px;margin:0 auto 16px; }
        .donut-svg   { transform:rotate(-90deg); }
        .donut-label { position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center; }
        .donut-label .num { font-size:24px;font-weight:800;color:var(--text-dark, #0f172a); }
        .donut-label .sub { font-size:11px;color:var(--text-muted, #64748b); }

        .activity-item { display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--border-light, #e2e8f0); }
        .activity-item:last-child { border-bottom:none; }
        .act-dot { width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0; }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="dashboard-body">
    <form id="form1" runat="server">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <div class="dashboard-shell">
            <!-- Sidebar -->
            <aside class="dashboard-sidebar" id="dashboardSidebar">
                <a href="admin-dashboard.aspx" class="sidebar-brand">
                    <span class="brand-icon"><i class="fa-solid fa-shield-halved"></i></span>
                    <span class="brand-text">
                        <span class="brand-name">SIMS</span>
                        <span class="brand-sub">Admin Panel</span>
                    </span>
                </a>
                <nav class="sidebar-nav">
                    <ul>
                        <li><a href="admin-dashboard.aspx" class="sidebar-link active" id="sl-dashboard">
                            <i class="fa-solid fa-house"></i> Dashboard
                        </a></li>
                    </ul>

                    <div class="sidebar-divider"></div>
                    <p class="co-sidebar-label">User Management</p>
                    <ul>
                        <li><a href="admin-students.aspx" class="sidebar-link" id="sl-students">
                            <i class="fa-solid fa-user-graduate"></i> Student Management
                        </a></li>
                        <li><a href="admin-companies.aspx" class="sidebar-link" id="sl-companies">
                            <i class="fa-solid fa-building"></i> Company Management
                        </a></li>
                    </ul>

                    <div class="sidebar-divider"></div>
                    <p class="co-sidebar-label">Operations</p>
                    <ul>
                        <li><a href="admin-internships.aspx" class="sidebar-link" id="sl-internships">
                            <i class="fa-solid fa-briefcase"></i> Internship Management
                        </a></li>
                        <li><a href="admin-interviews.aspx" class="sidebar-link" id="sl-interviews">
                            <i class="fa-solid fa-calendar-check"></i> Interview & Placement
                        </a></li>
                    </ul>

                    <div class="sidebar-divider"></div>
                    <ul>
                        <li><a href="admin-notifications.aspx" class="sidebar-link" id="sl-communication">
                            <i class="fa-solid fa-bullhorn"></i> Communication & Reports
                        </a></li>
                    </ul>

                    <div class="sidebar-divider"></div>
                    <ul>
                        <li><a href="admin-settings.aspx" class="sidebar-link" id="sl-settings">
                            <i class="fa-solid fa-gear"></i> Settings
                        </a></li>
                    </ul>

                    <div class="sidebar-divider"></div>
                    <ul>
                        <li>
                            <asp:LinkButton ID="lbSidebarLogout" runat="server" OnClick="lbLogout_Click" CssClass="sidebar-link dropdown-danger">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </nav>
            </aside>

            <!-- Main Column -->
            <div class="dashboard-main-col">
                <!-- Topbar -->
                <header class="dashboard-topbar">
                    <div class="dashboard-topbar-left">
                        <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle menu">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <div class="dashboard-page-title">
                            Admin Dashboard<span>Complete platform overview &amp; management</span>
                        </div>
                    </div>
                    <div class="dashboard-topbar-right">
                        <button type="button" class="icon-btn dash-icon-btn" id="dashNotifBtn" aria-label="Notifications">
                            <i class="fa-regular fa-bell"></i><span class="badge">3</span>
                        </button>
                        <div class="dash-profile-trigger" id="dashProfileTrigger">
                            <span class="dash-avatar-sm" id="dashAvatarSm" style="background:linear-gradient(135deg,#2563eb,#7c3aed);">SA</span>
                            <span class="dash-name" id="dashNameTop">
                                <asp:Literal ID="litAdminName" runat="server" Text="System Administrator" />
                                <span>Administrator</span>
                            </span>
                            <i class="fa-solid fa-chevron-down" style="font-size:11px;color:#94a3b8;"></i>
                            <div class="profile-dropdown" id="profileDropdown">
                                <a href="admin-profile.aspx"><i class="fa-solid fa-user-shield"></i> Admin Profile</a>
                                <a href="admin-settings.aspx"><i class="fa-solid fa-gear"></i> Settings</a>
                                <hr>
                                <asp:LinkButton ID="lbDropdownLogout" runat="server" OnClick="lbLogout_Click" CssClass="dropdown-danger">
                                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                                </asp:LinkButton>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Dashboard Content Area -->
                <main class="dashboard-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <!-- Footer -->
                <footer class="dashboard-footer">
                    <p>&copy; 2026 SIMS - Smart Student Internship Management System. All rights reserved.</p>
                </footer>
            </div>
        </div>
    </form>

    <!-- Sync Session with localStorage for client-side JS -->
    <script>
        try {
            localStorage.setItem('simsSession', JSON.stringify({
                role: 'admin',
                name: '<%= Session["UserName"] != null ? Session["UserName"].ToString().Replace("'", "\\'") : "System Administrator" %>',
                email: '<%= Session["UserEmail"] != null ? Session["UserEmail"].ToString().Replace("'", "\\'") : "admin@sims.com" %>'
            }));
        } catch (e) { }
    </script>
    <script src="<%= ResolveUrl("~/js/global-store.js") %>"></script>
    <script src="<%= ResolveUrl("~/js/script.js") %>"></script>
</body>
</html>