<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="public.master.cs" Inherits="asp.net._public" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>SIMS - Smart Student Internship Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/style.css") %>">
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <!-- ============ HEADER ============ -->
                <header class="site-header">

                    <!-- Top bar -->
                    <div class="topbar">
                        <div class="container topbar-inner">
                            <p class="topbar-tagline">
                                <i class="fa-solid fa-graduation-cap"></i>Empowering Students. Connecting Companies. Building Careers.
                            </p>
                            <div class="topbar-right">
                                <a href="tel:+918849900762" class="topbar-link"><i class="fa-solid fa-phone"></i>88499 00762</a>
                                <a href="support@sims.com" class="topbar-link"><i class="fa-solid fa-envelope"></i>support@sims.com</a>
                                <div class="topbar-socials">
                                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                    <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                                    <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main nav -->
                    <div class="navbar">
                        <div class="container navbar-inner">
                            <a href="<%= ResolveUrl("~/PublicPanel/index.aspx") %>" class="brand">
                                <span class="brand-icon"><i class="fa-solid fa-graduation-cap"></i></span>
                                <span class="brand-text">
                                    <span class="brand-name">SIMS</span>
                                    <span class="brand-sub">Smart Student Internship Management System</span>
                                </span>
                            </a>
                            <nav class="main-nav" id="mainNav">
                                <ul>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/index.aspx") %>" data-nav-page="index.aspx">Home</a></li>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/internships.aspx") %>" data-nav-page="internships.aspx">Internships</a></li>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/companies.aspx") %>" data-nav-page="companies.aspx">Companies</a></li>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/stories.aspx") %>" data-nav-page="stories.aspx">Success Stories</a></li>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/about.aspx") %>" data-nav-page="about.aspx">About Us</a></li>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/contact.aspx") %>" data-nav-page="contact.aspx">Contact Us</a></li>
                                    <li><a href="<%= ResolveUrl("~/PublicPanel/faq.aspx") %>" data-nav-page="faq.aspx">FAQ</a></li>
                                </ul>
                            </nav>
                            <div class="navbar-actions">
                                <asp:ImageButton ID="imgBtnLoginRegister" runat="server" ImageUrl="~/assets/login register.png" PostBackUrl="~/PublicPanel/login.aspx" Width="150px" />
                            </div>
                        </div>
                    </div>
                </header>
            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <!-- ============ PAGE CONTENT ============ -->
                <main>
                    <section class="hero">
                        <div class="hero-bg-shape"></div>
                        <div class="container hero-inner">

                            <div class="hero-content">
                                <span class="hero-badge">Find. Learn. Grow.</span>
                                <h1 class="hero-title">Find The Perfect<br />
                                    <span class="text-blue">Internship Opportunity</span>
                                </h1>
                                <p class="hero-desc">
                                    SIMS helps students discover real-world internships that match their skills and career goals. Start your journey today!
                                </p>
                                <div class="hero-btns">
                                    <asp:ImageButton ID="imgBtnExploreInternships" runat="server" ImageUrl="~/assets/home.png" PostBackUrl="~/PublicPanel/internships.aspx" Width="200px" />
                                </div>
                                <div class="hero-trusted">
                                    <span>Trusted by Students &amp; Top Companies</span>
                                    <div class="trusted-logos">
                                        <asp:Image ID="imgMasterLogoGoogle" runat="server" ImageUrl="~/assets/logo-google.png" CssClass="trusted-logo-img" />
                                        <asp:Image ID="imgMasterLogoMicrosoft" runat="server" ImageUrl="~/assets/logo-microsoft.png" CssClass="trusted-logo-img" />
                                        <asp:Image ID="imgMasterLogoTcs" runat="server" ImageUrl="~/assets/logo-tcs.svg" CssClass="trusted-logo-img" />
                                        <asp:Image ID="imgMasterLogoInfosys" runat="server" ImageUrl="~/assets/logo-infosys.png" CssClass="trusted-logo-img" />
                                        <asp:Image ID="imgMasterLogoWipro" runat="server" ImageUrl="~/assets/logo-wipro.svg" CssClass="trusted-logo-img" />
                                        <asp:Image ID="imgMasterLogoAmazon" runat="server" ImageUrl="~/assets/logo-amazon.png" CssClass="trusted-logo-img" />
                                    </div>
                                </div>
                            </div>

                            <div class="hero-media">
                                <div class="hero-blob"></div>
                                <asp:Image ID="imgMasterHeroStudent" runat="server" ImageUrl="~/assets/hero-student.png" CssClass="hero-image" />
                                <div class="float-card float-card-1">
                                    <span class="float-icon icon-blue"><i class="fa-solid fa-briefcase"></i></span>
                                    <div>
                                        <strong>10K+</strong>
                                        <p>Active Internships</p>
                                    </div>
                                </div>
                                <div class="float-card float-card-2">
                                    <span class="float-icon icon-green"><i class="fa-solid fa-user-group"></i></span>
                                    <div>
                                        <strong>25K+</strong>
                                        <p>Students</p>
                                    </div>
                                </div>
                                <div class="float-card float-card-3">
                                    <span class="float-icon icon-orange"><i class="fa-solid fa-building"></i></span>
                                    <div>
                                        <strong>1K+</strong>
                                        <p>Top Companies</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="container">
                            <div class="stats-bar">
                                <div class="stat-item">
                                    <span class="stat-icon icon-blue"><i class="fa-solid fa-briefcase"></i></span>
                                    <div>
                                        <strong>10,000+</strong>
                                        <p>Active Internships</p>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-icon icon-green"><i class="fa-solid fa-user-group"></i></span>
                                    <div>
                                        <strong>25,000+</strong>
                                        <p>Registered Students</p>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-icon icon-purple"><i class="fa-solid fa-building"></i></span>
                                    <div>
                                        <strong>1,200+</strong>
                                        <p>Top Companies</p>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-icon icon-red"><i class="fa-solid fa-award"></i></span>
                                    <div>
                                        <strong>95%</strong>
                                        <p>Success Rate</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </main>
            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                <!-- ============ FOOTER ============ -->
                <footer class="site-footer">
                    <div class="container footer-grid">

                        <div class="footer-col footer-about">
                            <a href="<%= ResolveUrl("~/PublicPanel/index.aspx") %>" class="brand brand-footer">
                                <span class="brand-icon"><i class="fa-solid fa-graduation-cap"></i></span>
                                <span class="brand-text">
                                    <span class="brand-name">SIMS</span>
                                    <span class="brand-sub">Smart Student Internship Management System</span>
                                </span>
                            </a>
                            <p class="footer-desc">
                                We bridge the gap between aspiring students and innovative companies by providing the best internship opportunities.
                            </p>
                            <div class="footer-socials">
                                <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                                <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                                <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                            </div>
                        </div>

                        <div class="footer-col">
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/index.aspx") %>"><i class="fa-solid fa-angle-right"></i>Home</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/about.aspx") %>"><i class="fa-solid fa-angle-right"></i>About Us</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/internships.aspx") %>"><i class="fa-solid fa-angle-right"></i>Internships</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/companies.aspx") %>"><i class="fa-solid fa-angle-right"></i>Companies</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/stories.aspx") %>"><i class="fa-solid fa-angle-right"></i>Success Stories</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/contact.aspx") %>"><i class="fa-solid fa-angle-right"></i>Contact Us</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/faq.aspx") %>"><i class="fa-solid fa-angle-right"></i>FAQ</a></li>
                            </ul>
                        </div>

                        <div class="footer-col">
                            <h4>For Students</h4>
                            <ul>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/internships.aspx") %>"><i class="fa-solid fa-angle-right"></i>Browse Internships</a></li>
                                <li><a href="<%= ResolveUrl("~/PublicPanel/login.aspx") %>"><i class="fa-solid fa-angle-right"></i>Apply Internship</a></li>
                                <li><a href="<%= ResolveUrl("~/StudentPanel/student-dashboard.aspx") %>"><i class="fa-solid fa-angle-right"></i>Student Dashboard</a></li>
                                <li><a href="<%= ResolveUrl("~/StudentPanel/student-my-internships.aspx") %>"><i class="fa-solid fa-angle-right"></i>My Applications</a></li>
                            </ul>
                        </div>

                        <div class="footer-col">
                            <h4>For Companies</h4>
                            <ul>
                                <li><a href="<%= ResolveUrl("~/CompanyPanel/company-internship.aspx") %>"><i class="fa-solid fa-angle-right"></i>Post Internship</a></li>
                                <li><a href="<%= ResolveUrl("~/CompanyPanel/company-internships.aspx") %>"><i class="fa-solid fa-angle-right"></i>Manage Internships</a></li>
                                <li><a href="<%= ResolveUrl("~/CompanyPanel/company-dashboard.aspx") %>"><i class="fa-solid fa-angle-right"></i>Company Dashboard</a></li>
                                <li><a href="<%= ResolveUrl("~/CompanyPanel/company-profile.aspx") %>"><i class="fa-solid fa-angle-right"></i>Company Profile</a></li>
                            </ul>
                        </div>

                        <div class="footer-col">
                            <h4>Contact Us</h4>
                            <ul class="footer-contact">
                                <li><i class="fa-solid fa-location-dot"></i>RK University Main Campus, Rajkot</li>
                                <li><i class="fa-solid fa-phone"></i>+91 88499 00762</li>
                                <li><i class="fa-solid fa-envelope"></i>support@sims.com</li>
                                <li><i class="fa-solid fa-clock"></i>Mon - Sat (9:00 AM - 6:00 PM)</li>
                            </ul>
                        </div>

                        <div class="footer-col footer-newsletter">
                            <h4>Subscribe to our Newsletter</h4>
                            <p>Get the latest updates about internships, career tips and more.</p>
                            <div class="newsletter-form">
                                <asp:TextBox ID="TextBox1" runat="server" TextMode="Email" CssClass="newsletter-input" placeholder="Enter your email address" Height="45px" Width="200px"></asp:TextBox>
                                <asp:ImageButton ID="btnNewsletter" runat="server" ImageUrl="~/assets/btn_send_newsletter.png" Width="52px" Height="46px" CssClass="newsletter-img-btn" />
                            </div>
                        </div>
                    </div>

                    <div class="footer-bottom">
                        <div class="container footer-bottom-inner">
                            <p>&copy; 2026 SIMS - Smart Student Internship Management System. All rights reserved.</p>
                            <div class="footer-bottom-links">
                                <a href="#">Privacy Policy</a>
                                <span>|</span>
                                <a href="#">Terms &amp; Conditions</a>
                                <span>|</span>
                                <a href="#">Refund Policy</a>
                                <span>|</span>
                                <a href="#">Support</a>
                            </div>
                        </div>
                    </div>

                    <asp:ImageButton ID="scrollTopBtn" ClientIDMode="Static" runat="server" ImageUrl="~/assets/btn_scroll_top.png" CssClass="scroll-top" Width="44px" Height="44px" OnClientClick="window.scrollTo({top:0, behavior:'smooth'}); return false;" />
                </footer>

                <script src="<%= ResolveUrl("~/js/global-store.js") %>"></script>
                <script src="<%= ResolveUrl("~/js/script.js") %>"></script>
            </asp:ContentPlaceHolder>

        </div>
    </form>
</body>
</html>
