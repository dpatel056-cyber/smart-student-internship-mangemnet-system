<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="company.master.cs" Inherits="asp.net.company" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Dashboard - SIMS | Smart Student Internship Management System</title>
    <meta name="description" content="SIMS Company Dashboard - Manage internships, applications, and hiring from one place.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/style.css") %>">
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/company-module.css") %>">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="dashboard-body">
    <form id="form1" runat="server">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="dashboard-shell">
            <!-- Sidebar -->
            <aside class="dashboard-sidebar" id="dashboardSidebar">
                <a href="Companydashboard.aspx" class="sidebar-brand">
                    <span class="brand-icon"><i class="fa-solid fa-building"></i></span>
                    <span class="brand-text">
                        <span class="brand-name">SIMS</span>
                        <span class="brand-sub">Company Panel</span>
                    </span>
                </a>
                <nav class="sidebar-nav">
                    <ul>
                        <li><a href="Companydashboard.aspx" class="sidebar-link active" id="sl-dashboard">
                            <i class="fa-solid fa-house"></i> Dashboard
                        </a></li>
                    </ul>
                    <div class="sidebar-divider"></div>
                    <p class="co-sidebar-label">Company</p>
                    <ul>
                        <li><a href="company-profile.aspx" class="sidebar-link" id="sl-profile">
                            <i class="fa-solid fa-building"></i> Company Profile
                        </a></li>
                        <li><a href="company-edit-profile.aspx" class="sidebar-link" id="sl-edit-profile">
                            <i class="fa-solid fa-pen-to-square"></i> Edit Profile
                        </a></li>
                    </ul>
                    <div class="sidebar-divider"></div>
                    <p class="co-sidebar-label">Internship Management</p>
                    <ul>
                        <li><a href="company-post-internship.aspx" class="sidebar-link" id="sl-post">
                            <i class="fa-solid fa-plus-circle"></i> Post Internship
                        </a></li>
                        <li><a href="company-manage-internships.aspx" class="sidebar-link" id="sl-manage">
                            <i class="fa-solid fa-layer-group"></i> Manage Internships
                        </a></li>
                        <li><a href="company-applications.aspx" class="sidebar-link" id="sl-applications">
                            <i class="fa-solid fa-file-lines"></i> View Applications
                        </a></li>
                    </ul>
                    <div class="sidebar-divider"></div>
                    <p class="co-sidebar-label">Interview &amp; Hiring</p>
                    <ul>
                        <li><a href="company-interview-schedule.aspx" class="sidebar-link" id="sl-interviews">
                            <i class="fa-solid fa-calendar-check"></i> Interview Schedule
                        </a></li>
                        <li><a href="company-offer-letter.aspx" class="sidebar-link" id="sl-offer">
                            <i class="fa-solid fa-envelope-open-text"></i> Offer Letters
                        </a></li>
                    </ul>
                    <div class="sidebar-divider"></div>
                    <p class="co-sidebar-label">Reports &amp; Communication</p>
                    <ul>
                        <li><a href="company-reports.aspx" class="sidebar-link" id="sl-reports">
                            <i class="fa-solid fa-file-invoice"></i> Reports Generation
                        </a></li>
                        <li><a href="company-analytics.aspx" class="sidebar-link" id="sl-analytics">
                            <i class="fa-solid fa-chart-pie"></i> Analytics Dashboard
                        </a></li>
                    </ul>
                    <div class="sidebar-divider"></div>
                    <ul>
                        <li>
                            <asp:LinkButton ID="lbSidebarLogout" runat="server" OnClick="lbLogout_Click" CssClass="sidebar-link dropdown-danger">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </nav>
            </aside>

            <!-- Main Column -->
            <div class="dashboard-main-col">
                <!-- Topbar -->
                <header class="dashboard-topbar">
                    <div class="dashboard-topbar-left">
                        <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle menu">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <div class="dashboard-page-title">
                            Company Dashboard
                            <span>Manage your internships, applications and team</span>
                        </div>
                    </div>
                    <div class="dashboard-topbar-right">
                        <button type="button" class="icon-btn dash-icon-btn" id="dashNotifBtn" aria-label="Notifications">
                            <i class="fa-regular fa-bell"></i>
                            <span class="badge">2</span>
                        </button>
                        <div class="dash-profile-trigger" id="dashProfileTrigger">
                            <span class="dash-avatar-sm" id="dashAvatarSm" style="background:linear-gradient(135deg,#2563eb,#7c3aed);">CO</span>
                            <span class="dash-name" id="dashNameTop">
                                <asp:Literal ID="litCompanyName" runat="server" Text="Company Partner" />
                                <span>Company</span>
                            </span>
                            <i class="fa-solid fa-chevron-down" style="font-size:11px;color:#94a3b8;"></i>
                            <div class="profile-dropdown" id="profileDropdown">
                                <a href="company-profile.aspx"><i class="fa-solid fa-building"></i> Company Profile</a>
                                <a href="company-settings.aspx"><i class="fa-solid fa-gear"></i> Settings</a>
                                <hr>
                                <asp:LinkButton ID="lbDropdownLogout" runat="server" OnClick="lbLogout_Click" CssClass="dropdown-danger">
                                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                                </asp:LinkButton>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Dashboard Content Area -->
                <main class="dashboard-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <!-- Footer -->
                <footer class="dashboard-footer">
                    <p>&copy; 2026 SIMS - Smart Student Internship Management System. All rights reserved.</p>
                </footer>
            </div>
        </div>
    </form>

    <!-- Sync Session with localStorage for client-side JS -->
    <script>
        try {
            localStorage.setItem('simsSession', JSON.stringify({
                role: 'company',
                name: '<%= Session["UserName"] != null ? Session["UserName"].ToString().Replace("'", "\\'") : "Company Partner" %>',
                email: '<%= Session["UserEmail"] != null ? Session["UserEmail"].ToString().Replace("'", "\\'") : "company@sims.com" %>'
            }));
        } catch (e) { }
    </script>
    <script src="<%= ResolveUrl("~/js/global-store.js") %>"></script>
    <script src="<%= ResolveUrl("~/js/script.js") %>"></script>
</body>
</html>
